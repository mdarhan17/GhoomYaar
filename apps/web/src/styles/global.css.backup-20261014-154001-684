@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');
:root{font-family:'DM Sans',system-ui,sans-serif;color:#193a39;background:#f7faf8;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box}body{margin:0}a{text-decoration:none;color:inherit}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.65;cursor:wait}
h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Plus Jakarta Sans',system-ui,sans-serif;letter-spacing:-.045em}h1{line-height:1.12}p{line-height:1.7;color:#5b7372}.container{width:min(1180px,calc(100% - 48px));margin:auto}.app-shell{min-height:100vh;display:flex;flex-direction:column}main{flex:1}
.topbar{position:sticky;top:0;background:#fffdfbee;backdrop-filter:blur(20px);border-bottom:1px solid #e4ece8;z-index:5}.topbar-inner{height:76px;width:min(1180px,calc(100% - 48px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:23px;white-space:nowrap}.brand-mark{display:inline-grid;place-items:center;background:#0d8278;color:white;width:31px;height:31px;border-radius:10px;margin-right:5px}.brand-dot{color:#0d8278}.topbar nav{display:flex;gap:30px;align-items:center}.topbar nav a{color:#526966;font-weight:700;font-size:14px}.topbar nav a.active,.topbar nav a:hover{color:#06766b}
.btn{border:0;border-radius:12px;display:inline-flex;justify-content:center;align-items:center;padding:15px 22px;font-weight:800;font-size:14px;min-height:46px;transition:transform .15s ease}.btn:hover{transform:translateY(-2px)}.btn-primary{background:#0c8074;color:#fff;box-shadow:0 9px 25px #0c80742b}.btn-outline{background:transparent;border:1px solid #bbd0c7;color:#17655d}.btn-ghost{background:#e8f4ef;color:#12655d}.btn-small{min-height:37px;padding:10px 15px}.actions{display:flex;gap:12px;flex-wrap:wrap}
.hero{background:linear-gradient(118deg,#f4fbf6 0%,#eff8f0 53%,#e1f4e9 100%);border-bottom:1px solid #e1ece6;overflow:hidden}.hero-grid{min-height:600px;display:grid;grid-template-columns:1.08fr 1fr;align-items:center;gap:45px}.eyebrow{color:#0b8a7d;text-transform:uppercase;letter-spacing:.19em;font-size:11px;font-weight:800}.hero h1{font-size:clamp(42px,5.2vw,76px);margin:20px 0}.hero h1 span{color:#0d8e82}.hero p{font-size:17px;max-width:530px;margin-bottom:30px}.hero-notes{display:flex;gap:22px;margin-top:34px;color:#6a827e;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.09em}
.hero-art{height:410px;border-radius:34px;position:relative;overflow:hidden;box-shadow:0 40px 80px #154b4422;background:linear-gradient(160deg,#8cdbc7 0%,#d0f1df 52%,#f4efc5 100%)}.sun{position:absolute;top:48px;right:100px;width:140px;height:140px;border-radius:100%;background:#ffe9a2;box-shadow:0 0 70px #ffebb3}.mountain{position:absolute;bottom:-110px;transform:rotate(-23deg);border-radius:65px;width:520px;height:400px}.mountain.back{background:#4bb69b;left:-130px;bottom:-120px}.mountain.front{background:#0b756c;left:130px;bottom:-165px;transform:rotate(20deg)}.hero-art-card{position:absolute;left:25px;bottom:25px;background:#fffffff0;padding:20px 24px;border-radius:17px;display:flex;flex-direction:column;gap:5px;box-shadow:0 12px 35px #16463c24}.hero-art-card span{letter-spacing:.12em;font-size:10px;color:#0c8479;font-weight:800}.hero-art-card strong{font-size:19px}.hero-art-card small{color:#748783}
.section{padding:70px 0}.section-heading{margin-bottom:28px}.section-heading h1{font-size:46px;margin:10px 0}.section-heading h2{font-size:35px;margin:12px 0}.section-heading p{max-width:650px}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.feature-card,.state-card,.profile-card{padding:30px;border:1px solid #e0ebe5;border-radius:20px;background:#fff;box-shadow:0 10px 35px #24453b08}.feature-card h3{margin:18px 0 8px;font-size:20px}.emoji{font-size:29px}.footer{background:#102d2a;color:#c7d9d2;font-size:13px;padding:24px 0}
.filterbar{display:flex;gap:16px;flex-wrap:wrap;background:#fff;border:1px solid #e1eae6;padding:22px;border-radius:18px}.filterbar label{display:flex;flex-direction:column;gap:7px;flex:1;min-width:230px;font-size:13px;font-weight:800;color:#476663}input,select{border:1px solid #d8e5df;background:white;border-radius:10px;padding:12px 13px;color:#24433e;outline:none;width:100%;min-height:44px}input:focus,select:focus{border-color:#0b8a7d;box-shadow:0 0 0 3px #0b8a7d1c}.results-heading{display:flex;align-items:center;justify-content:space-between;margin:32px 0 20px}.results-heading h2{font-size:22px;margin:0}.results-heading span{color:#6b817b;font-size:14px}.states-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.state-card{position:relative;padding:20px;display:flex;flex-direction:column;gap:7px;min-height:160px}.state-icon{display:grid;place-items:center;background:#e5f7f1;color:#178477;border-radius:12px;height:36px;width:36px;font-size:24px}.state-card strong{margin-top:8px}.state-card small{color:#648078}.state-kind{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#3b9788;font-weight:800;margin-top:auto}
.auth-wrap{min-height:calc(100vh - 180px);display:grid;place-items:center;padding:55px 22px;background:linear-gradient(135deg,#e7f5ed,#f9fbf8)}.auth-card{width:min(460px,100%);border-radius:24px;background:#fff;padding:40px;box-shadow:0 30px 60px #0d50401a}.auth-card h1{font-size:35px;margin:10px 0}.auth-card form{display:flex;flex-direction:column;gap:17px;margin-top:25px}.auth-card label{display:flex;flex-direction:column;gap:7px;font-weight:800;font-size:13px}.full{width:100%}.form-error{background:#fff0ef;border:1px solid #ffd2cc;color:#a8372d;border-radius:10px;padding:11px 13px;font-size:13px}.switch-link{font-size:13px;text-align:center;margin:20px 0 0}.switch-link a{color:#067a70;font-weight:800}.profile h1{font-size:40px}.profile>p{max-width:650px}.profile-card{max-width:540px;margin-top:35px}.profile-card dl{display:grid;grid-template-columns:125px 1fr;gap:15px}.profile-card dt{color:#78918b}.profile-card dd{margin:0;font-weight:700}
@media(max-width:920px){.hero-grid{grid-template-columns:1fr;padding:65px 0}.hero-art{height:290px}.states-grid{grid-template-columns:repeat(3,1fr)}.feature-grid{grid-template-columns:1fr 1fr}.topbar nav{gap:12px}}@media(max-width:640px){.container,.topbar-inner{width:min(100% - 28px,1180px)}.topbar-inner{height:auto;padding:14px 0;flex-wrap:wrap}.topbar nav{order:3;width:100%;justify-content:space-between}.topbar nav a{font-size:12px}.brand{font-size:19px}.brand-mark{width:27px;height:27px}.hero-grid{gap:35px}.hero h1{font-size:44px}.hero-art{height:260px}.hero-notes{flex-wrap:wrap;gap:10px}.section{padding:42px 0}.states-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.state-card{padding:16px;min-height:145px}.auth-card{padding:25px}.section-heading h1{font-size:35px}}